# Copy to .env and change the passwords:  cp .env.example .env
# Never commit .env to Git. All data is synthetic.

# ---- LLM (Ollama). Pick by free RAM (run scripts/check_vm.sh) ----
#   under 5 GB  -> qwen2.5:1.5b   (986 MB download)
#   5 to 11 GB  -> qwen2.5:3b     (1.9 GB, default)
#   11 GB+      -> qwen2.5:7b     (4.7 GB, better answers, slower on CPU)
OLLAMA_MODEL=qwen2.5:3b
# auto = use database tools, fall back to context mode if the model has no tool support
LLM_MODE=auto
OLLAMA_NUM_CTX=4096

# ---- Secrets (change these) ----
# Every /v1/* call to the LLM API needs the header:  X-Service-Key: <SERVICE_KEY>
SERVICE_KEY=change-me-service-key
POSTGRES_PASSWORD=change-me-postgres
LLM_READER_PASSWORD=change-me-reader

# ---- Ports and access ----
UI_PORT=8080
# Who can reach the LLM API (port 8010):
#   127.0.0.1 = only this VM (teammates use an SSH tunnel)
#   0.0.0.0   = anyone on the network who has the SERVICE_KEY (use a firewall)
LLM_API_BIND=127.0.0.1
